{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "jsx": "react-jsx",
    "types": [
      "vite/client",
      "@testing-library/jest-dom/vitest"
    ],
    "baseUrl": ".",
    "paths": {
      "@/*": [
        "src/client/*"
      ],
      "@shared/*": [
        "src/shared/*"
      ]
    }
  },
  "include": [
    "src/client",
    "src/shared",
    "tests/client",
    "tests/shared"
  ]
}